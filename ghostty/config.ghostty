config-file = ?auto/theme.ghostty
command = fish
shell-integration = fish
# alt+hjkl and alt+1..9 intentionally unbound - reserved for tmux pane/window
# navigation. Do not bind goto_split/goto_tab to them here.
keybind = alt+1=unbind
keybind = alt+2=unbind
keybind = alt+3=unbind
keybind = alt+4=unbind
keybind = alt+5=unbind
keybind = alt+6=unbind
keybind = alt+7=unbind
keybind = alt+8=unbind
keybind = alt+9=unbind
keybind = alt+digit_1=unbind
keybind = alt+digit_2=unbind
keybind = alt+digit_3=unbind
keybind = alt+digit_4=unbind
keybind = alt+digit_5=unbind
keybind = alt+digit_6=unbind
keybind = alt+digit_7=unbind
keybind = alt+digit_8=unbind
keybind = ctrl+shift+x=toggle_split_zoom
keybind = ctrl+shift+e=new_split:right
keybind = ctrl+shift+o=new_split:down
keybind = ctrl+shift+g=reset
notify-on-command-finish-action = bell,notify
notify-on-command-finish-after = 10s
bell-features = system,title,attention,border
scrollback-limit = 104857600
# Adds 10 pixels of padding on the top and bottom
window-padding-y = 0,20

# Adds 10 pixels of padding on the left and right (optional, but looks better)
window-padding-x = 10

# Machine-specific config (decrypted from hosts/<id>/ by setup.sh)
config-file = ?~/.config/ghostty/config.d/*
